# Development Environment Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database Configuration (Local MySQL/MariaDB)
DATABASE_URL="mysql://root:@localhost:3306/relief_supply_chain"

# JWT Authentication
JWT_SECRET=disaster_relief_jwt_secret_development_key_2026
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Real-Time WebSocket
SOCKET_PORT=3000

# GraphHopper Routing & Geocoding API Key
GRAPHOPPER_API_KEY=YOUR_GRAPHHOPPER_API_KEY

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
