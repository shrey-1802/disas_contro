# Production Environment Configuration
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database Configuration (Production MySQL)
DATABASE_URL="mysql://prod_user:CHANGE_ME_SECURE_PASSWORD@db.example.com:3306/relief_supply_chain"

# JWT Authentication (Use strong production secrets)
JWT_SECRET=CHANGE_ME_USE_STRONG_PRODUCTION_KEY_MIN_32_CHARS_REQUIRED
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# CORS Configuration (Production domains)
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# Rate Limiting (Production settings)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Real-Time WebSocket
SOCKET_PORT=3000

# GraphHopper Routing API Key (Required for routing)
GRAPPHOPPER_API_KEY=YOUR_GRAPHHOPPER_PRODUCTION_API_KEY

# Logging
LOG_LEVEL=warn
LOG_FORMAT=json

# Security
HELMET_ENABLED=true
CSP_ENABLED=true
