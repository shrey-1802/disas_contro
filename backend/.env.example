# Environment Variables for Disaster Relief Supply Chain Intelligence Platform Backend

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database Configuration (MySQL / MariaDB / SQLite)
DATABASE_URL="mysql://root:@localhost:3306/relief_supply_chain"
# DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=disaster_relief_jwt_secret_production_ready_key_2026
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Real-Time WebSocket
SOCKET_PORT=3000

# GraphHopper Routing & Geocoding API Key
GRAPHHOPPER_API_KEY=YOUR_GRAPHHOPPER_API_KEY
